#!/usr/bin/bash

# # graphical sudo prompt
# export SUDO_ASKPASS=$(kdialog --password $0)

# reset NTP
echo "Restting NTP."
sudo timedatectl set-ntp false
sudo timedatectl set-ntp true
echo "Done."

# reload BT kernel modules
echo "Reloading Bluetooth."
sudo modprobe -r btusb
sudo modprobe btusb
sudo systemctl restart bluetooth
echo "Done."

# reload audio drivers and music server
echo "Reloading audio drivers."
systemctl --user restart wireplumber pipewire pipewire-pulse mpd
echo "Done."
